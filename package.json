{
  "name": "sekar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run security:secrets && npm run build && npm run security:bundle",
    "db:seed-sql": "node scripts/generate-seed-sql.mjs",
    "db:test-local": "bash supabase/tests/run-local.sh",
    "build:e2e-supabase": "APP_DATA_MODE=supabase NEXT_PUBLIC_SUPABASE_URL=https://proyek-uji.supabase.co NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_placeholder_e2e NEXT_DIST_DIR=.next-supabase next build",
    "test:e2e:supabase": "npm run build:e2e-supabase && npm run security:supabase-bundle && playwright test -c playwright.supabase.config.ts",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:history": "node scripts/check-secrets.mjs --history",
    "security:bundle": "node scripts/check-secrets.mjs --bundle",
    "db:seed-remote": "node scripts/supabase-seed.mjs",
    "db:test-seed-script": "bash supabase/tests/seed-script-local.sh && bash supabase/tests/seed-parts-local.sh",
    "security:supabase-bundle": "node scripts/check-secrets.mjs --supabase-bundle",
    "db:test-all": "bash supabase/tests/run-local.sh && bash supabase/tests/seed-minimal-local.sh && bash supabase/tests/activation-local.sh && bash supabase/tests/seed-script-local.sh && bash supabase/tests/seed-parts-local.sh",
    "db:activation-sql": "node scripts/generate-activation-sql.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
