# SEKAR — contoh konfigurasi. JANGAN isi nilai rahasia di file ini.
# Salin menjadi .env.local hanya bila diperlukan (.env* diabaikan git, kecuali file ini).
# Tanpa file .env apa pun, aplikasi berjalan dalam mode dummy (data simulasi, PUBLIK).

# Mode data: "dummy" (default, tanpa backend, tanpa kontrol akses) atau "supabase".
APP_DATA_MODE=dummy

# Hanya untuk APP_DATA_MODE=supabase. Keduanya nilai PUBLIK yang memang dikirim ke browser:
# URL proyek (https://) dan anon/publishable key. Akses data dijaga RLS + MFA (aal2).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TIDAK DIPERLUKAN oleh aplikasi ini. Jangan pernah menaruh service-role / secret key
# (sb_secret_..., JWT role=service_role) di variabel NEXT_PUBLIC_* — aplikasi akan menolak
# berjalan bila mendeteksinya. Bila kelak dibutuhkan untuk skrip admin, simpan hanya
# sebagai variabel server (tanpa awalan NEXT_PUBLIC_) di Vercel/CI, bukan di repo.
