# SEKAR — contoh konfigurasi. JANGAN isi nilai rahasia di file ini.
# Salin menjadi .env.local hanya bila diperlukan. Tanpa file .env apa pun,
# aplikasi berjalan dalam mode dummy (data simulasi).

# Mode data: "dummy" (default, tanpa backend) atau "supabase" (opsional).
APP_DATA_MODE=dummy

# Hanya untuk APP_DATA_MODE=supabase. Keduanya nilai PUBLIK (URL proyek & anon key).
# Jangan pernah menaruh service-role key di sini atau di variabel NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
